{
  "buildCommand": "bash build-vercel.sh",
  "framework": null,
  "redirects": [
    {
      "source": "/collections/moody-tablescape-edit",
      "destination": "/collections/moody-thanksgiving-edit",
      "permanent": true
    },
    {
      "source": "/collections/luxe-christmas-tree",
      "destination": "/collections/luxe-christmas-tree-edit",
      "statusCode": 301
    },
    {
      "source": "/collections/cozy-christmas-bedroom",
      "destination": "/collections/cozy-christmas-bedroom-edit",
      "statusCode": 301
    },
    {
      "source": "/collections/heritage-christmas",
      "destination": "/collections/heritage-christmas-edit",
      "statusCode": 301
    },
    {
      "source": "/collections/holiday-hosting",
      "destination": "/collections/holiday-hosting-edit",
      "statusCode": 301
    },
    {
      "source": "/collections/thanksgiving-table",
      "destination": "/collections/thanksgiving-table-edit",
      "statusCode": 301
    },
    {
      "source": "/collections/moody-thanksgiving",
      "destination": "/collections/moody-thanksgiving-edit",
      "statusCode": 301
    },
    {
      "source": "/collections/thanksgiving-hosting",
      "destination": "/collections/thanksgiving-hosting-edit",
      "statusCode": 301
    },
    {
      "source": "/collections/thanksgiving-welcome",
      "destination": "/collections/thanksgiving-welcome-edit",
      "statusCode": 301
    },
    {
      "source": "/evergreen-house/privacy",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|webp|avif|gif|svg|ico))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|woff2?))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap(.*)\\.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/marketing",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/marketing/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
